# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://norbs:change-me@db:5432/norbscoin
PUBLIC_BASE_URL=https://exchange.example.com

# 32+ random characters. Encrypts MFA secrets at rest. Generate: openssl rand -base64 48
APP_SECRET=

# Number of trusted reverse proxies in front of the app (for client IPs, HTTPS detection).
TRUST_PROXY=1
ADMIN_SESSION_TTL_HOURS=12

# Reference rate provider: open_er_api (ExchangeRate-API open endpoint) or manual (operator rates only)
RATE_PROVIDER=open_er_api
RATE_REFRESH_SECONDS=900

# Evidence storage: disk (UPLOAD_DIR) or db (inside PostgreSQL; for hosts without a persistent disk)
STORAGE_BACKEND=disk

# Private evidence storage directory (must NOT be web-served; mount a persistent, backed-up volume)
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=5242880

# Email: smtp (transactional provider via SMTP) or log (prints to stdout; development only)
EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=NorbsCoin <no-reply@exchange.example.com>

JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=30

# Optional: create the first owner account at startup when no operator exists yet
# (for hosts without a command line). Remove after first sign-in.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
